# =============================================================================
# School E-Mart Backend — Environment Configuration
# Copy this file to `.env` and fill in values for your environment.
# =============================================================================

# --- Core ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
API_VERSION=v1

# --- Database (required in production) ---
# Use either MONGODB_URI or MONGO_URI (Atlas connection string).
MONGODB_URI=mongodb://127.0.0.1:27017/school-emart
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/school-emart

# --- JWT & Auth Secrets (required in production, min 32 chars, no dev- prefix) ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
# Legacy — refresh tokens are opaque UUIDs; kept for backward compatibility
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
OTP_HMAC_SECRET=dev-otp-hmac-secret-change-me

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=school-emart
JWT_AUDIENCE=school-emart-api

# --- Password Hashing ---
BCRYPT_ROUNDS=12

# --- Cookies ---
# COOKIE_SECURE auto-enables in production; override with true/false
# COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
REFRESH_COOKIE_NAME=refreshToken

# --- CORS (comma-separated origins) ---
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Login Lockout ---
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# --- OTP ---
OTP_EXPIRY=10m
OTP_RESEND_COOLDOWN_MS=60000
OTP_MAX_PER_WINDOW=5
OTP_WINDOW_MS=900000

# --- Password Reset & Email Verification ---
PASSWORD_RESET_EXPIRY=24h
EMAIL_VERIFICATION_EXPIRY=24h
FRONTEND_URL=http://localhost:5173

# --- Logging ---
LOG_LEVEL=debug
LOG_DIR=logs
REQUEST_ID_HEADER=x-request-id

# --- Graceful Shutdown ---
SHUTDOWN_TIMEOUT_MS=10000

# --- Redis (optional — enables distributed login lockout & OTP cooldown) ---
# REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=school-emart:
# REDIS_CONNECT_TIMEOUT_MS=10000
# REDIS_STARTUP_MAX_ATTEMPTS=5
# REDIS_STARTUP_RETRY_DELAY_MS=2000

# --- Outbox worker (disabled by default) ---
OUTBOX_WORKER_ENABLED=false
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20

# --- Razorpay (required for online payments) ---
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=your_key_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Delivery: Shiprocket ---
DELIVERY_PROVIDER=shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=
# SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
# SHIPROCKET_RPM_LIMIT=500
